# ============================================================
# Portfolio Show — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── Django Core ─────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False

# Comma-separated list of allowed hosts (your Render backend domain)
ALLOWED_HOSTS=portfolio-show-api.onrender.com

# Comma-separated trusted origins for CSRF (must include your backend URL)
CSRF_TRUSTED_ORIGINS=https://portfolio-show-api.onrender.com

# Site ID for django.contrib.sites (usually 1)
SITE_ID=1

# ── Database — Neon PostgreSQL ───────────────────────────────
# Get this from your Neon project dashboard → Connection Details
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Neon provides a "pooled" connection string (recommended for production):
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# SSL is automatically enforced when .neon.tech appears in the URL.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/portfolio_show?sslmode=require

# Connection pool: how long (seconds) to keep a DB connection alive (0 = close after each request)
DB_CONN_MAX_AGE=60

# ── CORS — Frontend Origin(s) ───────────────────────────────
# Comma-separated list of frontend origins allowed to make cross-origin requests.
# Add your Render Static Site URL and any local dev URLs.
CORS_ORIGINS=https://portfolio-show.onrender.com,http://localhost:5173

# ── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: full Cloudinary URL (used as alternative to the three vars above)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_AUTH_TOKEN_KEY=

# ── Secure Video Settings ────────────────────────────────────
SECURE_VIDEO_STREAM_TTL_SECONDS=300
SECURE_VIDEO_DOWNLOAD_TTL_SECONDS=600
SECURE_VIDEO_USE_CLOUDINARY_TOKENS=true

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: override the Telegram API base URL (default: https://api.telegram.org)
# TELEGRAM_API_BASE=https://api.telegram.org

# ── AI Assistants ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_TIMEOUT_SECONDS=20

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_TIMEOUT_SECONDS=20

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=no-reply@portfolio-show.local

# ── Frontend Shell (optional) ────────────────────────────────
# Absolute path to the frontend index.html served by Django's frontend_shell view.
# Leave empty to use the auto-detected path (../frontend/index.html relative to backend/).
# FRONTEND_SOURCE_PATH=/path/to/frontend/index.html

# ── Cross-Origin Cookies (local dev only) ───────────────────
# Set to true if your local frontend and backend are on different ports AND
# you need session cookies to work cross-origin in development.
# In production (IS_RENDER=True) this is applied automatically.
# FORCE_CROSS_ORIGIN_COOKIES=false
