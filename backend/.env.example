# Portfolio Show — Node.js & TypeScript Backend Environment Variables

# Server Environment
NODE_ENV=production
PORT=8000

# Database (Neon PostgreSQL with connection pooling & SSL required)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session & Security
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Cross-Origin Resource Sharing (CORS)
# Add your live frontend URL (e.g. https://portfolio-show.onrender.com)
CORS_ORIGINS=https://portfolio-show.onrender.com,http://localhost:5173

# Cloudinary Media Storage (For direct video & avatar uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Assistants
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Telegram Bot Integration (Download Request Notifications)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
