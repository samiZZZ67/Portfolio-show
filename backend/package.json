{
  "name": "portfolio-show-backend",
  "version": "1.0.0",
  "description": "Portfolio Show — Node.js & TypeScript REST API Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
